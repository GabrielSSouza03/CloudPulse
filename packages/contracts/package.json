{
  "name": "@cloudpulse/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned event and API contracts shared by the platform, simulator, load tests and SDKs.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schemas:snapshot": "pnpm build && node scripts/write-schema-snapshot.js"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
