# Local development defaults. Copy to `.env` (gitignored). Never commit real credentials.
NODE_ENV=development
LOG_LEVEL=info

# Each process connects with its own least-privilege PostgreSQL role.
DATABASE_URL_API=postgres://cloudpulse_api:api@localhost:15432/cloudpulse
DATABASE_URL_GATEWAY=postgres://cloudpulse_api:api@localhost:15432/cloudpulse
DATABASE_URL_WORKER=postgres://cloudpulse_worker:worker@localhost:15432/cloudpulse
DATABASE_URL_MIGRATOR=postgres://cloudpulse_migrator:migrator@localhost:15432/cloudpulse

REDIS_URL=redis://localhost:16379
KAFKA_BROKERS=localhost:19092
REDPANDA_ADMIN_URL=http://localhost:19644
CLICKHOUSE_URL=http://localhost:18123

API_PORT=3000
GATEWAY_PORT=3002
WORKER_PORT=3003

# Human auth: the api is an OIDC resource server. Locally, `pnpm dev:token` creates a signing
# key under .dev/ and mints tokens; in other environments set AUTH_JWKS_URL instead.
AUTH_JWT_ISSUER=https://dev.cloudpulse.local
AUTH_JWT_AUDIENCE=cloudpulse-api
AUTH_DEV_JWKS_PATH=../../.dev/jwks.json

# OpenTelemetry: export is enabled only when an endpoint is set (start `pnpm dev:up:obs`).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
